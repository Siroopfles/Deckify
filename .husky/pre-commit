STAGED_NON_PLANNING=$(git diff --cached --name-only | grep -v '^\.planning/' || true)
if [ -z "$STAGED_NON_PLANNING" ]; then
  exit 0
fi

pnpm exec lint-staged
pnpm run typecheck
pnpm test
pnpm run build
python3 -m unittest discover -s tests -p "test_*.py" 2>/dev/null || python -m unittest discover -s tests -p "test_*.py" 2>/dev/null || py -m unittest discover -s tests -p "test_*.py"
